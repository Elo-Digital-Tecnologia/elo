# Application
NODE_ENV=development
PORT=3000
API_PORT=4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=elo_digital
DB_PASSWORD=elo_digital
DB_NAME=elo_digital
DATABASE_URL=postgresql://elo_digital:elo_digital@localhost:5432/elo_digital

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session (Table/Customer)
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_MAX_AGE=14400000

# Superadmin
SUPERADMIN_KEY=generate-random-64-char-hex-key

# Frontend URLs
WEB_ADMIN_URL=http://localhost:3001
WEB_RESTAURANT_URL=http://localhost:3002
WEB_MENU_URL=http://localhost:3003
WEB_KITCHEN_URL=http://localhost:3004

# API URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# WebSocket
WS_PORT=4001