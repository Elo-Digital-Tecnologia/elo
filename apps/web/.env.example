# All of these are written into the build: change one, build again.
# The API as the web server reaches it, for the /api proxy.
API_URL=http://localhost:3001
# The API as the browser reaches it, for the realtime socket. A localhost value
# follows the page's host instead, so phones on the local network work too.
NEXT_PUBLIC_API_URL=http://localhost:3001
# false hides the API docs link in the Elo panel (when the API runs with API_DOCS off).
# NEXT_PUBLIC_API_DOCS=false
