# NODE_ENV comes from the monorepo root .env, shared with the web app.

# Application
APP_PORT=3001
APP_PREFIX=api
# Web app address: the base of table links and QR codes.
APP_PUBLIC_URL=http://localhost:3000
# Restaurant day for reports and opening hours.
APP_TIME_ZONE=America/Sao_Paulo
# Swagger at /docs.
APP_DOCS=true
APP_UPLOAD_DIR=./uploads
# Allowed browser origins (comma separated, or * for any). Outside production, local
# network origins are allowed too, for testing from a phone.
APP_CORS_ORIGINS=http://localhost:3000
APP_CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Postgres connection
PG_HOST=localhost
PG_PORT=5433
PG_USER=elo
PG_PASS=elo
PG_DBNAME=elo_digital
# Database used only by the e2e tests (pnpm --filter @elo/api db:test:prepare creates it).
PG_TEST_DBNAME=elo_digital_test
# TLS, for managed databases reached by their public address.
PG_SSL=false

# JWT (long random values, never committed: openssl rand -hex 32)
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRES_IN=60min

# Sessions
# A staff session nobody used for this long ends; each use pushes the end forward.
SESSION_REFRESH_EXPIRES_IN=30d
SESSION_TABLE_EXPIRES_IN=4h

# Superadmin
SUPERADMIN_KEY=change-me-to-another-long-random-value

# Rate limit
THROTTLE_TTL=60s
THROTTLE_LIMIT=300

# Data retention
# A deleted restaurant's data is kept this long (restore or export) before being erased.
RETENTION_RESTAURANT_PURGE_IN=90d
RETENTION_AUDIT_LOG_IN=180d
RETENTION_AUDIT_LOG_CLEANUP_EVERY=24h

# Web Push (pnpm --filter @elo/api vapid:generate). Empty keys turn push off.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:). Defaults to APP_PUBLIC_URL.
PUSH_VAPID_SUBJECT=
