DATABASE_URL=postgres://elo:elo@localhost:5433/elo_digital
# Database used only by the e2e tests (pnpm --filter @elo/api db:test:prepare creates it).
DATABASE_URL_TEST=postgres://elo:elo@localhost:5433/elo_digital_test
# Long random values, never committed: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value
SUPERADMIN_KEY=change-me-to-another-long-random-value
API_PORT=3001
# Hosting platforms set PORT; it wins over API_PORT.
# PORT=
# production turns on secure cookies, the strict CORS list and the startup checks
# (https addresses, secrets of 32+ chars).
# NODE_ENV=production
# Swagger at /docs: always on outside production; in production only when true.
# API_DOCS=false
# TLS to the database, for managed databases reached by their public URL.
# DATABASE_SSL=false
# Web app addresses: allowed browser origins, and the base of table links and QR codes.
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Restaurant day for reports (default America/Sao_Paulo).
REPORT_TZ=America/Sao_Paulo
UPLOAD_DIR=./uploads
# Days a deleted restaurant's data is kept (restore or export) before being erased for good.
RESTAURANT_PURGE_DAYS=90
# Activity log entries older than this are erased; the cleanup runs every ACTIVITY_CLEANUP_HOURS.
ACTIVITY_RETENTION_DAYS=180
ACTIVITY_CLEANUP_HOURS=24
# Web Push for staff phones. Generate with: pnpm --filter @elo/api vapid:generate
# Empty keys turn push off (alerts still show inside the open panel).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:). Defaults to PUBLIC_BASE_URL.
VAPID_SUBJECT=
