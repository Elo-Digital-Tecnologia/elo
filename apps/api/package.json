{
    "name": "@elo/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./dist/*"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "node scripts/dev.mjs",
        "start": "node dist/main.js",
        "start:dev": "node scripts/dev.mjs",
        "lint": "eslint src test",
        "test": "vitest run --project unit",
        "test:e2e": "vitest run --project e2e",
        "migration:generate": "pnpm build && typeorm migration:generate -d dist/database/data-source.js",
        "vapid:generate": "node scripts/vapid-generate.mjs",
        "db:test:prepare": "node scripts/test-db.mjs",
        "db:seed": "node dist/database/seeds/demo.js"
    },
    "dependencies": {
        "@elo/core": "workspace:*",
        "@nestjs/common": "^10.4.4",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.4",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.4",
        "@nestjs/platform-socket.io": "^10.4.4",
        "@nestjs/swagger": "^7.4.2",
        "@nestjs/throttler": "^6.2.1",
        "@nestjs/typeorm": "^10.0.2",
        "@nestjs/websockets": "^10.4.4",
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cookie-parser": "^1.4.7",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.13.0",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sharp": "^0.35.5",
        "socket.io": "^4.8.0",
        "typeorm": "^0.3.20",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@elo/config": "workspace:*",
        "@nestjs/cli": "^10.4.5",
        "@nestjs/testing": "^10.4.4",
        "@swc/core": "^1.16.21",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.7",
        "@types/express": "^4.17.21",
        "@types/multer": "^2.3.0",
        "@types/node": "^22.7.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/qrcode": "^1.5.5",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.12.0",
        "socket.io-client": "^4.8.4",
        "supertest": "^7.0.0",
        "typescript": "^5.6.0",
        "unplugin-swc": "^2.0.0",
        "vitest": "^5.1.0"
    }
}
