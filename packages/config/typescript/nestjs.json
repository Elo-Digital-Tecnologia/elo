{
  "extends": "./base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@elo-digital/core/*": ["../../core/src/*"],
      "@elo-digital/ui/*": ["../../ui/src/*"],
      "@elo-digital/config/*": ["../*"],
      "@elo-digital/database/*": ["../../database/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}