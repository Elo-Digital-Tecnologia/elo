{
  "name": "@elo-digital/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./entities": "./src/entities/index.ts",
    "./entities/*": "./src/entities/*.ts",
    "./data-source": "./src/data-source.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "migration:generate": "ts-node --project tsconfig.migration.json ./node_modules/typeorm/cli.js migration:generate ./src/database/migrations/ -d ./src/data-source.ts",
    "migration:run": "ts-node --project tsconfig.migration.json ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
    "migration:revert": "ts-node --project tsconfig.migration.json ./node_modules/typeorm/cli.js migration:revert -d ./src/data-source.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@elo-digital/config": "workspace:*",
    "@elo-digital/core": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}